# Paraclr environment. Copy to .env.local and fill in what you have.
# Every variable is optional: with none set, the app runs fully in demo mode
# (simulated passkey, simulated prices, in-memory clearing).
# NEXT_PUBLIC_* values are inlined into the client bundle at `next build` time.

# ---- Privy (passkey login + embedded wallet on Monad testnet) --------------
# From https://dashboard.privy.io. Enable "Passkey" as a login method there.
# Unset → "Sign in with FaceID" simulates the passkey and signs in as demo.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional app client id (Privy dashboard → App clients).
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ---- Site -------------------------------------------------------------------
# Public origin of the deployed site, used for absolute Open Graph / X card
# image URLs (e.g. https://paraclr.vercel.app). Unset → localhost in dev,
# the Vercel URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# ---- Chain mode ---------------------------------------------------------------
# sim   (default) fully in-browser simulation, no chain
# anvil local anvil, chain 31337: start it with `npm run dev:chain`
# monad Monad testnet, chain 10143
# monad-mainnet  Monad MAINNET production beta, chain 143: reads deployments/143.json only,
#                refuses a deployment without "production": true, never falls back to simulation.
# Changing it needs a `next dev` restart.
NEXT_PUBLIC_CHAIN_MODE=sim
# Local anvil RPC (anvil mode). Default http://127.0.0.1:8545
NEXT_PUBLIC_ANVIL_RPC_URL=
# Keeper HTTP API (faucet, flash crash, run reports). Default http://127.0.0.1:8787.
# A hosted app needs the keeper reachable over HTTPS (see keeper/README.md).
NEXT_PUBLIC_KEEPER_URL=

# ---- Monad mainnet (chain id 143, production beta) ---------------------------
# Strongly recommended: a dedicated/paid RPC. Defaults to https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=
# Optional, display only: a Hermes endpoint that needs no API key. Trading never sends
# Pyth update data from the browser; it uses the prices already stored on chain.
NEXT_PUBLIC_PYTH_HERMES_URL=
# Server-only: read deployments/<chainId>.json from another directory (fork rehearsals).
PARACLR_DEPLOYMENTS_DIR=

# ---- Monad testnet (chain id 10143) -----------------------------------------
# Optional RPC override; defaults to https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=

# ---- Contract addresses (0x-prefixed) ----------------------------------------
# In anvil/monad mode the app reads deployments/<chainId>.json (written by
# `npm run dev:chain` / `npm run deploy:monad`). These are only fallbacks for
# when that file is missing. Invalid/empty → treated as not deployed.
NEXT_PUBLIC_CLEARINGHOUSE_ADDRESS=
NEXT_PUBLIC_AUSD_ADDRESS=
# Optional; otherwise read from the clearinghouse (`oracle()`).
NEXT_PUBLIC_ORACLE_ADDRESS=

# ---- Chainlink Data Streams -------------------------------------------------
# WebSocket URL of a server-side relay (browsers can't send the HMAC auth
# headers, and the API secret must never ship to the client).
# Unset → simulated price feed.
NEXT_PUBLIC_CHAINLINK_STREAMS_WS=
# Data Streams feed IDs (0x… 32-byte) per market.
NEXT_PUBLIC_CHAINLINK_FEED_MON=
NEXT_PUBLIC_CHAINLINK_FEED_SOL=
NEXT_PUBLIC_CHAINLINK_FEED_BTC=
# Server-only credentials for the relay. Never prefix these with NEXT_PUBLIC_.
CHAINLINK_API_KEY=
CHAINLINK_API_SECRET=

# ============================================================================
# Keeper / deploy (chain backend). These do NOT go in .env.local.
# They live in keeper/.env (gitignored). Create that file with FRESH keys via
#   npm run keeper:init
# which prints only addresses. Never paste a private key anywhere.
# Local anvil (`npm run dev:chain`) needs none of this: it uses anvil's public
# dev keys and ignores keeper/.env (local overrides: keeper/.env.anvil).
# Full reference + Monad testnet runbook: keeper/README.md
# ============================================================================
# KEEPER_RPC_URL=https://testnet-rpc.monad.xyz      # default http://127.0.0.1:8545
# OPERATOR_PRIVATE_KEY=        # owner of AUSD/oracle/clearinghouse; deployer (npm run deploy:monad)
# PRICE_PUSHER_PRIVATE_KEY=    # oracle updater, pushes prices
# FAUCET_PRIVATE_KEY=          # gas + AUSD faucet
# KEEPER_PRIVATE_KEYS=         # 8 comma-separated keys, lane i <-> key i
# KEEPER_PORT=8787
# KEEPER_CORS_ORIGIN=*         # or comma-separated app origins
# PRICE_PUSH_MS=1000           # each push ~55k gas (~0.0057 MON on Monad)
# PRICE_PUSH_IDLE_MS=600000    # pause pushes after 10 min without HTTP traffic (0 = never; anvil default 0)
# FAUCET_GAS_WEI=200000000000000000   # 0.2 MON per drip on Monad (10 ETH on anvil)
# FAUCET_COOLDOWN_MS=3600000
# KEEPER_GAS_MARGIN_BPS=1000   # gas limit = estimateGas * 1.10 (Monad bills the limit)
# KEEPER_MAX_TX_GAS=30000000   # split a lane batch above this (Monad per-tx limit 30M)
# KEEPER_RECEIPT_POLL_MS=100   # receipt poll interval (= observation lag in measured timings)
# LANE_SEED=100000000000       # deploy: AUSD (6dp) per lane insurance fund
# Fair-liquidation sprint (details: keeper/README.md)
# BACKSTOP_MIN_DISCOUNT_BPS=75 # per-lane pool threshold set at deploy, both designs (below the legacy 1% fee)
# SWEEPER=1                    # every-block auction sweeper
# DEMO_TAKERS=1                # keeper-run demo external takers; default on for anvil, off on Monad
