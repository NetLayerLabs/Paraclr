    "keeper": "tsx keeper/src/index.ts",
    "keeper:init": "tsx keeper/src/init-env.ts",
    "keeper:fund": "tsx keeper/src/fund-roles.ts",
    "bench": "tsx bench/run.ts",
    "xray": "tsx bench/xray.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
