{
  "name": "paraclr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sandbox": "NEXT_PUBLIC_CHAIN_MODE=monad-testnet NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=http://127.0.0.1:8645 NEXT_PUBLIC_KEEPER_URL=http://127.0.0.1:8887 PARACLR_DEPLOYMENTS_DIR=deployments/sandbox PARACLR_DIST_DIR=.next-sandbox next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "abi": "npm run contracts:build && node scripts/export-abi.mjs",
    "dev:chain": "tsx scripts/dev-chain.ts",
    "deploy:anvil": "tsx scripts/deploy.ts --network anvil",
    "deploy:monad": "tsx scripts/deploy.ts --network monad",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts --network mainnet",
    "deploy:testnet": "tsx scripts/deploy-mainnet.ts --network testnet",
    "keeper": "tsx keeper/src/index.ts",
    "keeper:init": "tsx keeper/src/init-env.ts",
    "test:keeper": "tsx --test keeper/src/*.test.ts keeper/src/prod/*.test.ts",
    "keeper:fund": "tsx keeper/src/fund-roles.ts",
    "guardian:pause": "tsx keeper/src/prod/guardian.ts",
    "timelock": "tsx keeper/src/prod/timelock.ts",
    "pyth:push": "tsx keeper/src/prod/push-cli.ts",
    "bench": "tsx bench/run.ts",
    "xray": "tsx bench/xray.ts",
    "pyth:cadence": "tsx bench/pyth-cadence.ts",
    "rehearse:mainnet": "tsx scripts/rehearse-mainnet.ts",
    "rehearse:testnet": "tsx scripts/rehearse-testnet.ts",
    "oracle:fallback": "tsx scripts/testnet-oracle.ts",
    "sandbox": "tsx scripts/sandbox.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
