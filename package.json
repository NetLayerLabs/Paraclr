{
  "name": "paraclr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
