# Paraclr keeper / deploy — Monad MAINNET (chain 143)
#
#   cp keeper/.env.mainnet.example keeper/.env.mainnet
#   chmod 600 keeper/.env.mainnet
#
# keeper/.env.mainnet is gitignored. Fill it in on YOUR machine only.
# Never paste a private key into chat, an issue, a commit or a screenshot.
#
# Rules for every key below:
#   - Use FRESH keys made only for Paraclr (never your personal wallet's key).
#     `npm run keeper:init -- --network mainnet` can generate them for you and
#     prints only the addresses (writes this file with mode 600).
#   - These are HOT keys on a server: keep each balance small; top up as needed.
#   - None of these keys can change parameters, swap the oracle or move user
#     funds. Only the OWNER (multisig behind the timelock, below) can change
#     parameters, and only after the timelock delay.

# ---- Network ------------------------------------------------------------------
# A dedicated/paid RPC is strongly recommended for mainnet (rate limits).
KEEPER_RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143

# ---- Governance (ADDRESSES, not keys) ----------------------------------------
# Multisig (e.g. a Safe) that proposes/executes changes through the timelock.
# If Safe isn't available on Monad, use a hardware-wallet address — never a
# key that lives on a server.
OWNER_MULTISIG_ADDRESS=
# Timelock delay for parameter/oracle/owner changes. 86400 = 24 h.
TIMELOCK_MIN_DELAY_SECONDS=86400

# ---- Hot keys (private keys, 0x-prefixed) — fund with mainnet MON -------------
# Suggested starting balances are rough; `npm run keeper:fund -- --network mainnet`
# prints a precise preview from measured gas before sending anything.

# Deploys the contracts, wires roles, then hands ownership to the timelock.
# After deploy it holds no power; sweep its leftover MON away. (~5 MON)
DEPLOYER_PRIVATE_KEY=

# Guardian: can PAUSE new deposits/orders in an emergency. Cannot unpause,
# change parameters or touch funds. Keep it on a separate machine if possible. (~1 MON)
GUARDIAN_PRIVATE_KEY=

# Operations: funding-rate updates, monitoring reads. (~3 MON)
OPS_PRIVATE_KEY=

# 8 lane keepers, comma-separated, lane i <-> key i. They execute delayed orders
# and run auctions for their lane, paying Pyth update fees + gas; they earn the
# execution fees users attach to orders. (~2 MON each)
KEEPER_PRIVATE_KEYS=

# ---- Production limits (guarded beta) ----------------------------------------
# Applied at deploy; changeable later only through the timelock.
# AUSD has 6 decimals; values below are whole AUSD.
MAX_DEPOSIT_PER_ACCOUNT_AUSD=50
MAX_TVL_PER_LANE_AUSD=500
MAX_LEVERAGE=10

# ---- Collateral & oracle (Monad mainnet) -------------------------------------
# Verified sources: Agora AUSD on Monadscan; Pyth via docs.monad.xyz/tooling-and-infra/oracles.
# The deploy script re-checks both on chain before using them.
AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
PYTH_HERMES_URL=https://hermes.pyth.network

# ---- Keeper HTTP API ----------------------------------------------------------
KEEPER_PORT=8787
# Your deployed app origin(s), comma-separated. Never * on mainnet.
KEEPER_CORS_ORIGIN=

# ---- Alerting -----------------------------------------------------------------
# Optional webhook (Discord/Slack/Telegram-compatible) for low balances, failed
# executions, oracle staleness, pause events and solvency alerts.
ALERT_WEBHOOK_URL=

# ==============================================================================
# Added by the keeper / ops work (all optional unless marked REQUIRED).
# Full reference: keeper/README.md "Production (Monad mainnet)"; procedures: docs/RUNBOOK.md.
# ==============================================================================

# ---- Pyth Hermes --------------------------------------------------------------
# REQUIRED: since 2026-08-26 Hermes answers 401 without an API key (Authorization: Bearer).
# Get one at the Pyth Terminal (docs.pyth.network/price-feeds/core/upgrade/preparing).
# Server-side only: the app gets prices through the keeper's /hermes proxy, never this key.
PYTH_API_KEY=
# Extra Hermes-compatible endpoints tried in order when the primary fails (comma-separated).
# e.g. https://pyth.dourolabs.app/hermes (same key).
PYTH_HERMES_FALLBACK_URLS=
# Proxy /hermes/v2/updates/price/{latest|<t>} for the app (only this deployment's feeds,
# cached 1 s, rate-limited per IP). 0 disables it.
HERMES_PROXY=1

# ---- Hosting --------------------------------------------------------------------
# 1 = no env file: every variable comes from the platform's secret store (keeper/HOSTING.md).
KEEPER_SECRETS_FROM_ENV=0

# ---- Alert thresholds -------------------------------------------------------------
# Hot-key balance alerts (MON): warning below, critical below a quarter of it.
ALERT_MIN_KEEPER_MON=2
ALERT_MIN_OPS_MON=1
ALERT_MIN_GUARDIAN_MON=0.2
# Latest Pyth price age (s, vs chain time) that warns / is critical. The contract's own bound
# is maxPriceAge (60 s by default).
ALERT_PRICE_AGE_WARN_S=15
ALERT_PRICE_AGE_CRITICAL_S=60
# Lane TVL / lane-market OI utilisation (%) that warns.
ALERT_CAP_PCT=80
# Pyth AUSD/USD off peg by more than this (bps) warns; 4x is critical.
ALERT_DEPEG_BPS=50
# An order executed later than this after it became executable (s) raises exec:late.
EXEC_LATE_ALERT_S=10
# A still-active alert is re-sent at most this often (ms).
ALERT_REPEAT_MS=1800000
# 1 = if solvency() ever reads false AND GUARDIAN_PRIVATE_KEY is on this host, pause at once.
# (Recommended: keep the guardian key OFF the keeper host and leave this 0.)
AUTO_PAUSE_ON_INSOLVENCY=0

# ---- Pyth storage freshness (contract v2: stored / lane prices expire after 15 s) ---------
# on-demand (default): push pyth.updatePriceFeeds only when a keeper action needs Pyth STORAGE
#   (v2: before multi-leg executions; v3+: never — executions carry their own updates). Auctions
#   and fills carry their own updates; users get fresh updates through the keeper's /hermes proxy.
# interval: also keep every feed ≤ PYTH_PUSH_INTERVAL_S old while anything is open
#   (≈ 100 MON/day measured, despite third-party pushes). off: never push.
PYTH_PUSH_MODE=on-demand
PYTH_PUSH_INTERVAL_S=12
# Push when the newest stored/lane price would be older than maxStoredPriceAge − this (s).
PYTH_PUSH_MARGIN_S=4
# Other legs of multi-leg orders: auto (default: append on contract v3+, push on v2) |
# append (v3+: send [latest for the account's feeds, unique fill update]; no push) |
# push (v2: push the stale feeds to Pyth storage before the fill).
EXEC_OTHER_LEGS=auto

# ---- Auction batches (R2-09: ~74k gas/account to start, ~95k to take) -----------------------
# Every batch is chunked so its gas limit stays ≤ KEEPER_MAX_TX_GAS (30M) × this headroom.
KEEPER_BATCH_HEADROOM=0.8
# Cure line override in bps of maintenance (default: the contract's CURE_BUFFER_BPS, else 10000).
# SWEEPER_CURE_BPS=

# ---- Keeper earnings ----------------------------------------------------------------
# Each lane keeper claims its execution fees (MON) / expiry rewards (AUSD) above these.
CLAIM_MIN_MON=1
CLAIM_MIN_AUSD=1

# ---- Funding updates (OPS key) --------------------------------------------------------
# updateFunding(market) only when the rate would change by > FUNDING_MIN_CHANGE_BPS (relative)
# or is older than FUNDING_MAX_AGE_S. 0 = every contract interval (≈ 38.6 MON/day at 60 s).
FUNDING_MIN_CHANGE_BPS=500
FUNDING_MAX_AGE_S=3600

# ---- keeper:fund budget (MON targets from measured gas) ------------------------------
FUND_DAYS=14
BUDGET_ORDERS_PER_DAY=200
BUDGET_LIQUIDATIONS_PER_DAY=20
# Executions are reimbursed by users' execution fees (claimed automatically): float this many days.
BUDGET_EXECUTION_FLOAT_DAYS=2
# Explicit per-role targets (MON) override the computed ones:
# FUND_DEPLOYER_MON= FUND_GUARDIAN_MON= FUND_OPS_MON= FUND_KEEPER_MON=

# ---- Loop tuning (defaults are right for Monad's 0.4 s blocks) ------------------------
# KEEPER_HEAD_POLL_MS=200  SWEEPER_MIN_INTERVAL_MS=1000  MONITOR_INTERVAL_MS=10000
# KEEPER_LOG_RANGE=100 (public RPC eth_getLogs limit)  KEEPER_GAS_MARGIN_BPS=1000

# ---- Deploy-time knobs read by contracts/script/DeployProd.s.sol ---------------------------
# (deploy:mainnet passes them to forge; every other secret is stripped from forge's environment.
#  Defaults in brackets; afterwards they change only through the timelock.)
# The owner must be a contract (Safe). For a hardware-wallet owner set OWNER_IS_EOA=true.
OWNER_IS_EOA=false
# Pyth-stored and lane prices expire after this; supplied updates after MAX_PRICE_AGE_SECONDS.
MAX_STORED_PRICE_AGE_SECONDS=15
MAX_PRICE_AGE_SECONDS=30
MIN_EXEC_DELAY_SECONDS=3
# LP exit is two-step: request, then withdraw after this delay (and within 1 day).
BACKSTOP_WITHDRAW_DELAY_SECONDS=3600
# TRADING_FEE_BPS=5  MIN_POSITION_AUSD=10  OI_CAP_MULTIPLIER_BPS=50000 (OI cap = lane insurance × 5)
# MAX_LANE_OI_AUSD=(TVL cap × leverage)  SKEW_SCALE_AUSD=10000  MAX_FUNDING_BPS_PER_DAY=100
# FUNDING_INTERVAL_SECONDS=60  MAX_CONF_BPS=200  MAX_EXEC_DELAY_SECONDS=60
# MIN_EXECUTION_FEE_WEI=100000000000000000 (0.1 MON; measured keeper cost ≈ 0.044 avg MON at 102 gwei)
# BACKSTOP_MIN_DISCOUNT_BPS=(contract default 75)  LANE_INSURANCE_SEED_AUSD=0 (seed from the treasury Safe instead:
#   `npm run timelock -- --network mainnet seed --insurance 200 --pool 100`; with 0 insurance every OI cap is 0)
# PYTH_MAX_FEED_AGE_SECONDS=3600
