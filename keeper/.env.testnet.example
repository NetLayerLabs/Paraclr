# Paraclr keeper / deploy — Monad TESTNET (chain 10143), the PRODUCTION contract on test funds
# (docs/TESTNET_PLAN.md, docs/RUNBOOK.md "Testnet").
#
#   npm run keeper:init -- --network testnet      # creates keeper/.env.testnet from this file (mode 600)
#
# keeper/.env.testnet is gitignored. Fill it in on YOUR machine only.
# Never paste a private key into chat, an issue, a commit or a screenshot.
#
# Same rules as mainnet (keeper/.env.mainnet.example), with testnet values:
#   - FRESH keys made only for this testnet deployment (never reuse mainnet keys, never your wallet).
#   - Hot keys hold small amounts of TESTNET MON; `npm run keeper:fund -- --network testnet` prints
#     the targets from measured gas.
#   - Only the OWNER (a Safe behind the timelock) can change parameters, after the delay.

# ---- Network ------------------------------------------------------------------
KEEPER_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# The public RPC caps calls per second (each call in a batch counts): keep batches small.
# Rate-limited calls are retried with backoff. A dedicated endpoint can use 50.
KEEPER_RPC_BATCH_SIZE=10
# eth_getLogs window for the order executor (default 100). QuickNode's free Discover plan allows 5
# blocks per query: set 4 there. Same-tick reads go out as one Multicall3 call (KEEPER_MULTICALL=0 off).
# KEEPER_LOG_RANGE=4

# ---- Governance (ADDRESSES, not keys) ----------------------------------------
# A Safe on Monad testnet (app.safe.global, network "Monad Testnet"; tx service
# https://api.safe.global/tx-service/monad-testnet). Threshold ≥ 2 is required by the preflight;
# SAFE_MIN_THRESHOLD=1 accepts a 1-of-1 Safe on testnet.
OWNER_MULTISIG_ADDRESS=
# 600 s on testnet (the demo must be maintainable during judging). Mainnet keeps 24 h.
TIMELOCK_MIN_DELAY_SECONDS=600

# ---- Hot keys (private keys, 0x-prefixed) — fund with TESTNET MON -------------
DEPLOYER_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
OPS_PRIVATE_KEY=
# 8 lane keepers, comma-separated, lane i <-> key i.
KEEPER_PRIVATE_KEYS=
# Trial-end fallback only (KeeperSignedPyth, docs/RUNBOOK.md "Testnet: trial-end fallback"): signs
# prices off chain; holds NO MON and sends no transaction. Generated by keeper:init.
PRICE_SIGNER_PRIVATE_KEY=

# ---- Production limits (guarded beta values, same as mainnet) -----------------
MAX_DEPOSIT_PER_ACCOUNT_AUSD=50
MAX_TVL_PER_LANE_AUSD=500
MAX_LEVERAGE=10

# ---- Collateral, oracle and markets (Monad testnet; re-checked on chain by deploy:testnet) ----
# Agora AUSD on Monad testnet (docs.agora.finance contract deployments; 6 decimals, symbol AUSD).
# Get test AUSD from Agora's faucet contract 0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C:
# requestFunds(<your address>) → 10,000 AUSD (docs/RUNBOOK.md "Testnet AUSD").
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Pyth on Monad testnet: same address and feed ids as mainnet (version 1.4.6, fee 1 wei per message).
PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
PYTH_HERMES_URL=https://hermes.pyth.network
# MON/AUSD is NOT listed: the Pyth trial key is not entitled to MON/USD. Listing MON later goes
# through the timelock (listMarket) once Hermes access for it exists.
PROD_MARKETS=SOL/AUSD,BTC/AUSD

# ---- Keeper HTTP API ----------------------------------------------------------
KEEPER_PORT=8787
# Your deployed app origin(s), comma-separated. Never * on a real chain.
KEEPER_CORS_ORIGIN=

# ---- Alerting -----------------------------------------------------------------
ALERT_WEBHOOK_URL=

# ---- Pyth Hermes --------------------------------------------------------------
# REQUIRED while the clearinghouse runs on Pyth: Hermes answers 401 without a key. The trial key
# (ends ~2026-10-20) covers SOL/USD and BTC/USD only; nothing here ever asks Hermes for MON or
# AUSD/USD on testnet (AUSD_DEPEG_CHECK is off).
PYTH_API_KEY=
PYTH_HERMES_FALLBACK_URLS=
HERMES_PROXY=1

# ---- Trial-end fallback (KeeperSignedPyth) ------------------------------------
# Set once `npm run oracle:fallback -- --network testnet deploy` ran (it also records it in
# deployments/10143.json). With PRICE_SIGNER_PRIVATE_KEY set the keeper signs ahead of the
# timelocked setPyth and switches its price source live when it executes.
# KEEPER_SIGNED_PYTH_ADDRESS=
# Price source for the signer: pyth-mainnet (Pyth's stored prices on Monad mainnet, read-only) | sim
# SIGNED_PRICE_SOURCE=pyth-mainnet
# SIGNED_SOURCE_RPC=https://rpc.monad.xyz

# ---- Hosting --------------------------------------------------------------------
KEEPER_SECRETS_FROM_ENV=0

# ---- Alert thresholds (testnet keys hold little MON) -----------------------------------------
ALERT_MIN_KEEPER_MON=0.5
ALERT_MIN_OPS_MON=0.5
ALERT_MIN_GUARDIAN_MON=0.05
ALERT_PRICE_AGE_WARN_S=15
ALERT_PRICE_AGE_CRITICAL_S=60
ALERT_CAP_PCT=80
ALERT_POOL_CLOSED_H=6
EXEC_LATE_ALERT_S=10
ALERT_REPEAT_MS=1800000
AUTO_PAUSE_ON_INSOLVENCY=0
# Pyth AUSD/USD depeg alert: off on testnet (test AUSD has no value).
AUSD_DEPEG_CHECK=0

# ---- Pyth storage freshness ---------------------------------------------------------------------
# Nobody pushes Pyth on Monad testnet: the keeper carries a fresh update inside every execution and
# auction, and the app passes one through the /hermes proxy. on-demand never pushes on contract v5.
PYTH_PUSH_MODE=on-demand
PYTH_PUSH_INTERVAL_S=12
PYTH_PUSH_MARGIN_S=4
EXEC_OTHER_LEGS=auto

# ---- Monad reserve balance ------------------------------------------------------------------------
# Testnet Pyth charges 1 wei per update message, so keeper txs carry value: a key below 10 MON may
# send one only as its first tx in 3 blocks. The keeper spaces them (auto = on for a real chain).
MONAD_RESERVE_GUARD=auto

# ---- Auction batches --------------------------------------------------------------
KEEPER_BATCH_HEADROOM=0.8

# ---- Keeper earnings ----------------------------------------------------------------
CLAIM_MIN_MON=0.5
CLAIM_MIN_AUSD=1

# ---- Funding updates (OPS key) --------------------------------------------------------
FUNDING_MIN_CHANGE_BPS=500
# 6 h, and no max-age update at all while a market has no skew (rate and target 0).
FUNDING_MAX_AGE_S=21600
FUNDING_SKIP_IDLE=1

# ---- keeper:fund budget (testnet: ~3 weeks of light demo use) ------------------------------
FUND_DAYS=21
BUDGET_ORDERS_PER_DAY=30
BUDGET_LIQUIDATIONS_PER_DAY=1
BUDGET_EXECUTION_FLOAT_DAYS=2
BUDGET_FUNDING_CHANGES_PER_DAY=12
BUDGET_MIN_KEY_MON=0.2
# FUND_DEPLOYER_MON= FUND_GUARDIAN_MON= FUND_OPS_MON= FUND_KEEPER_MON=

# ---- Deploy-time knobs read by contracts/script/DeployProd.s.sol -------------------------------
# (deploy:testnet passes PROD_MARKETS with feed ids, CHAIN_ID=10143, DEPLOY_NETWORK=monad-testnet and
#  ALLOW_SHORT_TIMELOCK for the 600 s delay.)
OWNER_IS_EOA=false
MAX_STORED_PRICE_AGE_SECONDS=15
MAX_PRICE_AGE_SECONDS=30
MIN_EXEC_DELAY_SECONDS=3
BACKSTOP_WITHDRAW_DELAY_SECONDS=3600
# PYTH_MAX_FEED_AGE_SECONDS=3600 (SOL/BTC must have been pushed on testnet within 1 h: deploy:testnet
# pushes the latest Hermes update itself, which needs PYTH_API_KEY)
