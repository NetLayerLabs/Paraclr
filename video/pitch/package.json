{
  "name": "netlayer-pitch-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "draft": "remotion render src/index.ts Pitch out/pitch-draft.mp4 --scale 0.5 --crf 24",
    "render4k": "remotion render src/index.ts Pitch out/paraclr-pitch-4k-raw.mp4 --props=props-4k.json --scale 2 --image-format png --codec h264 --crf 14 --x264-preset slow --pixel-format yuv420p --audio-codec aac --audio-bitrate 320k",
    "poster": "remotion still src/index.ts Thumb out/paraclr-pitch-thumbnail.png --image-format png --scale 2",
    "edit": "node scripts/edit.mjs",
    "bed": "node scripts/bed.mjs",
    "typecheck": "tsc --noEmit",
    "music": "node scripts/music.mjs",
    "sfx": "node scripts/sfx.mjs",
    "voice": "node scripts/voice.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "timing": "node scripts/timing.mjs",
    "stills": "node scripts/stills.mjs",
    "sheet": "node scripts/sheet.mjs",
    "finish": "node scripts/finish.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "@remotion/media-utils": "4.0.530",
    "@remotion/paths": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  }
}
