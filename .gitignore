# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-sandbox/
/.next-testnet/
/.next-arena/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# chain backend: keeper/deploy keys are never committed (already covered by .env*,
# spelled out for safety); deployments/*.json and bench/results/*.json ARE committed.
keeper/.env*
contracts/.env*
!keeper/.env.example
!deployments/*.json
!bench/results/*.json
!keeper/.env.mainnet.example
!keeper/.env.testnet.example
# keeper/.env.testnet (testnet hot keys) and keeper/.env.sandbox (the sandbox's PYTH_API_KEY line) stay
# ignored by keeper/.env* above. The local sandbox's deployment and the price signer's state are local only.
deployments/sandbox/
keeper/.signer-state-*
# the testnet gas drip's ledger of dripped addresses (keeper/src/prod/drip.ts)
keeper/.drip-state-*
# arena mode's state (baseline prices, cycle counts, the uncrashed book; keeper/src/arena.ts)
keeper/.arena/

# teaser video (video/teaser): dependencies and renders stay local
video/teaser/node_modules
video/teaser/out

# demo film (video/demo): dependencies, renders, caches and recorded footage stay local
video/demo/node_modules/
video/demo/out/
video/demo/.cache/
video/demo/public/footage/
video/demo/public/stills/
