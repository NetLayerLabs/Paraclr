# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# chain backend: keeper/deploy keys are never committed (already covered by .env*,
# spelled out for safety); deployments/*.json and bench/results/*.json ARE committed.
keeper/.env*
contracts/.env*
!keeper/.env.example
!deployments/*.json
!bench/results/*.json
!keeper/.env.mainnet.example
